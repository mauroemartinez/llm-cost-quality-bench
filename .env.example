# Copy to .env and fill in only the providers you want to record with.
# With no keys at all, everything runs offline from fixtures/cassettes/.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# offline: replay recorded responses only (default when a provider has no key)
# record:  call the API and save every response as a cassette
# live:    call the API without saving
BENCH_MODE=offline

# Hard stop for real calls, in USD, for the whole run.
BENCH_MAX_USD=2
